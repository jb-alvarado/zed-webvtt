{
  "grammars": [
    {
      "name": "webvtt",
      "camelcase": "WebVTT",
      "scope": "source.webvtt",
      "path": ".",
      "file-types": ["vtt"],
      "first-line-regex": "^WEBVTT",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "A small Tree-sitter grammar for WebVTT subtitle files.",
    "authors": [
      {"name": "jb-alvarado"}
    ],
    "links": {
      "repository": "https://github.com/jb-alvarado/zed-webvtt"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
